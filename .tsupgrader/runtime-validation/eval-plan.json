{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "typecheck",
      "kind": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "homepage-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["start"],
      "env": {
        "PORT": "3000"
      },
      "url": "http://127.0.0.1:3000/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 90
    },
    {
      "name": "legacy-admin-login-route-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["start"],
      "env": {
        "PORT": "3000"
      },
      "url": "http://127.0.0.1:3000/admin-login",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 90
    }
  ]
}
